{
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "target": "es6",
    "outDir": "dist",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@config/*": ["./config/*"],
      "@routes/*": ["./src/routes/*"],
      "@controllers/*": ["./src/controllers/*"],
      "@models/*": ["./repo/*"],
      "@middlewares/*": ["./src/middlewares/*"],

      "database/*": ["./database/*"],
      "model/*": ["./model/*"],
    }
  },
}
